{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebDecryptHub",
  "version": "1.2.1",
  "identifier": "com.webdecrypthub.app",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {},
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMTlBQzk3MzYyRTdEMjIKUldRaWZTNDJsNndab1VNWTBZcmVGSVdXSTRRL2V3TitkTFBLdkVTdVZ3UTI5R1E3d2RCZnBpZE4K",
      "endpoints": [
        "https://github.com/decrypthub/WebDecryptHub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "WebDecryptHub"
}
